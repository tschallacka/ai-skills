inventory.md\"\n{\n    printf '# Work-unit inventory: %s\\n\\n' \"$(basename \"$plan_dir\")\"\n    printf '## Definition-of-done coverage\\n\\n'\n    printf '| Required outcome or proof | Work unit IDs | Notes |\\n|---|---|---|\\n\\n'\n    printf '## Work units\\n\\n'\n    printf '| ID | Type | File | Primary symbol or file scope | Subscope | Intended change | Depends on | Goal | Step |\\n'\n    printf '|---|---|---|---|---|---|---|---|---|\\n\\n'\n    printf '## Decomposition review\\n\\n'\n    printf '%s\\n' '- [ ] Every definition-of-done item maps to one or more work units.'\n    printf '%s\\n' '- [ ] Every known affected file and changing symbol has its own work unit.'\n    printf '%s\\n' '- [ ] Every work unit has exactly one goal and one step.'\n    printf '%s\\n' '- [ ] Each goal has 2–10 work units, or records an allowed exception.'\n    printf '%s\\n' '- [ ] Each step has exactly one work unit and no unnamed incidental edits.'\n    printf '%s\\n' '- [ ] Dependencies form an executable order with no cycle.'\n} > \"$inventory\"\ntrap - EXIT\necho \"Created $plan_dir\"\n","exit_code":0,"status":"completed"}}
