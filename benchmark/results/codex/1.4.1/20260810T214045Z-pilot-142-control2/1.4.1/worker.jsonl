plan-context-lib.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/plan-context.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/plan-document-lib.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/update-plan-content.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/update-plan-progress.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/update-progress.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/update-step.sh\n/tmp/ai-skills-capsules/20260810T214045Z-pilot-142-control2/1.4.1/worker/planning/scripts/validate-plan.sh\n","exit_code":0,"status":"completed"}}
