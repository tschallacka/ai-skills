an-directory> <goal>/<step> <section-id> -p N.N: <content> ...\\n  update-plan-content.sh -rp|--review-paragraph <plan-directory> <N.N> <text>\\n  update-plan-content.sh -rs|--review-section <plan-directory> <section-id> -p N.N: <content> ...\\n  update-plan-content.sh -tp|--table-paragraph <plan-directory> <document-id> <N.N> <columns> <CSV>\\n  update-plan-content.sh -ia|--insert-after <plan-directory> <document-id> <N.N> <text>\\n  update-plan-content.sh -ib|--insert-before <plan-directory> <document-id> <N.N> <text>\\n  update-plan-content.sh -t|--title <plan-directory> <document-id> <title>\\n  update-plan-content.sh -f|--field <plan-directory> <document-id> <field-label> <value>\\n  update-plan-content.sh -tr|--testing-requirement <plan-directory> <goal-name> <yes|no> <rationale>\\n  update-plan-content.sh -rv|--review-status <plan-directory> <pending|approved>\\n  update-plan-content.sh -dr|--decomposition-review <plan-directory> <incomplete|completed>\\n\\nDocument IDs: plan, review, goal:<goal>, step:<goal>/<step>, or unit:<WNN>.\\n\",\"exit_code\":64,\"status\":\"failed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"agent_message\",\"text\":\"The helper interfaces are available and the repository-local reviewer contract is loaded. Next I’m checking whether a fresh review subagent tool is callable; if it is, I’ll use it for the independent adversarial approval step.\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"agent_message\",\"text\":\"I’ve got the plan boundary: one future standalone `button-chain.html`, no HTML creation in this proof, and browser verification belongs in the plan as future work only. I’m creating the durable plan with two goals: build the page behavior atomically, then verify the user story and completion contract.\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'PLANNING_SKILL_DIR=/tmp/ai-skills-capsules/2026081