worker/planning/scripts/create-ui-story-run-cache.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/create-ui-validation.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/create-work-unit-inventory.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/generate-reviewer.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-content.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-context-lib.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-context-wrapper.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-context.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-document-lib.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-env.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/plan-mutate.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/rebuild-plan-progress.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/remove-work-unit.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/update-plan-content.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/update-plan-progress.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/update-progress.sh\n/tmp/ai-skills-capsules/20260811T205844Z-clean-current-seeded-fresh/current/worker/planning/scripts/update-step.sh\n/tmp/