        fi\\n                review_status='`✅ approved`'; description_status='✅ approved'\\n                ;;\\n            *) plan_die \\\"Review status must be pending or approved\\\" ;;\\n        esac\\n        review_tmp=\\\"${review}.tmp.$$\\\"; description_tmp=\\\"${description}.tmp.$$\\\"\\n        trap 'rm -f \\\"$review_tmp\\\" \\\"$description_tmp\\\"' EXIT\\n        awk -v replacement=\\\"$review_status\\\" '\\n            /^- Status:/ { if (found++) exit 2; print \\\"- Status: \\\" replacement; next }\\n            { print } END { if (found != 1) exit 2 }\\n        ' \\\"$review\\\" > \\\"$review_tmp\\\" || plan_die \\\"Review must contain exactly one Status field\\\"\\n        awk -v replacement=\\\"$description_status\\\" '\\n            /^- Status:/ { if (found++) exit 2; print \\\"- Status: \\\" replacement; next }\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n41:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '261,620p' /tmp/ai-skills-capsules/20260810T205301Z-pilot-142-final/1.4.1/worker/planning/scripts/validate-plan.sh && sed -n '321,620p' /tmp/ai-skills-capsules/20260810T205301Z-pilot-142-final/1.4.1/worker/planning/scripts/update-plan-content.sh && sed -n '1,220p' /tmp/ai-skills-capsules/20260810T205301Z-pilot-142-final/1.4.1/worker/planning/scripts/create-adversarial-review.sh && sed -n '1,180p' /tmp/ai-skills-capsules/20260810T205301Z-pilot-142-final/1.4.1/worker/planning/scripts/create-progress.sh && sed -n '1,180p' /tmp/ai-skills-capsules/20260810T205301Z-pilot-142-final/1.4.1/worker/planning/scripts/create-plan-progress.sh\\\"\",\"aggregated_output\":\"            done\\n            [ \\\"$has_proof\\\" = true ] || fail \\\"$id has no downstream test or verification work unit\\\"\\n            ;;\\n    esac\\ndone\\n\\ninteraction_pattern='[Cc]lick|[Tt]ap|[Tt]ype|[Kk]eyboard|[Pp]ress|[Ss]wipe|[Pp]inch|[Dd]rag|[Ss]elect'\\nprohibited_pattern='[Ee]valuate\\\