{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /tmp/ai-skills-capsules/20260811T074548Z-pilot-142-fresh-131-restart5/1.3.1/worker/planning/scripts/add-goal.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nif [ \"$#\" -ne 4 ]; then\n    echo \"Usage: $(basename \"$0\") <plan-directory> <goal-name> <title> <outcome>\" >&2\n    exit 64\nfi\n\nplan_dir=\"$1\"\ngoal_name=\"$2\"\ntitle=\"$3\"\noutcome=\"$4\"\nscript_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"$script_dir/plan-document-lib.sh\"\n\nplan_require_directory \"$plan_dir\"\n[[ \"$goal_name\" =~ ^[0-9][0-9]-[a-z0-9-]+$ ]] || plan_die \"Goal name must use 01-kebab-case\"\nplan_require_safe_value title \"$title\"\nplan_require_safe_value outcome \"$outcome\"\ngoal_dir=\"$plan_dir/$goal_name\"\n[ ! -e \"$goal_dir\" ] || plan_die \"Goal already exists: $goal_dir\"\n\nmkdir -p \"$goal_dir/steps\"\ngoal_file=\"$goal_dir/goal.md\"\ntemporary_file=\"${goal_file}.tmp.$$\"\ntrap 'rm -f \"$temporary_file\"; rmdir \"$goal_dir/steps\" \"$goal_dir\" 2>/dev/null || true' EXIT\n{\n    printf '# Goal: %s\\n\\n' \"$title\"\n    printf '## Current state and prior-goal handoffs\\n\\n§ 2.1\\n<confirmed facts and prerequisite handoffs>\\n\\n'\n    printf '## Outcome and definition of done\\n\\n§ 3.1\\n%s\\n\\n' \"$outcome\"\n    printf '## Why this goal is needed\\n\\n§ 4.1\\n<how this goal contributes to the initiative>\\n\\n'\n    printf '## Scope\\n\\n§ 5.1\\n<included and explicitly excluded behavior>\\n\\n'\n    printf '## Affected files, systems, data, and interfaces\\n\\n§ 6.1\\n<concrete affected areas>\\n\\n'\n    printf '## Dependencies and handoffs\\n\\n§ 7.1\\n<prerequisites and precise downstream handoffs>\\n\\n'\n    printf '## Implementation approach, risks, and edge cases\\n\\n§ 8.1\\n<approach, risks, and edge cases>\\n\\n'\n    printf '## Owned work units\\n\\n§ 9.1\\n<add work units with add-work-unit.sh>\\n\\n'\n    printf '## Goal-size exception\\n\\n§ 10.1\\n<required only when this goal has one permitted work unit>\\n'\n} > \"$temporary_file\"\nmv \"$temporary_file\" \"$goal_file\"\ntrap - EXIT\necho \"Created $goal_dir\"\n","exit_code":0,"status":"completed"}}
