{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /tmp/ai-skills-capsules/20260811T074548Z-pilot-142-fresh-131-restart5/1.3.1/worker/planning/scripts/create-plan.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nif [ \"$#\" -ne 2 ]; then\n    echo \"Usage: $(basename \"$0\") <plan-directory> <title>\" >&2\n    exit 64\nfi\n\nplan_dir=\"$1\"\ntitle=\"$2\"\nscript_dir=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"$script_dir/plan-document-lib.sh\"\n\n[[ \"$(basename \"$plan_dir\")\" =~ ^[a-z0-9][a-z0-9-]*$ ]] || plan_die \"Plan directory name must be kebab-case\"\n[ ! -e \"$plan_dir\" ] || plan_die \"Plan directory already exists: $plan_dir\"\nplan_require_safe_value title \"$title\"\n\nmkdir -p \"$plan_dir\"\ndescription=\"$plan_dir/plan-description.md\"\ntemporary_file=\"${description}.tmp.$$\"\ntrap 'rm -f \"$temporary_file\"; rmdir \"$plan_dir\" 2>/dev/null || true' EXIT\n{\n    printf '# Plan: %s\\n\\n' \"$title\"\n    printf '## Current state\\n\\n§ 2.1\\n<confirmed facts, available assets, and relevant prior work>\\n\\n'\n    printf '## Desired outcome\\n\\n§ 3.1\\n<definition of done>\\n\\n'\n    printf '## Approach\\n\\n§ 4.1\\n<agreed sequence and major implementation decisions>\\n\\n'\n    printf '## Scope\\n\\n§ 5.1\\n<included and explicitly excluded behavior>\\n\\n'\n    printf '## Affected areas\\n\\n§ 6.1\\n<files, modules, layouts, services, data, and systems>\\n\\n'\n    printf '## Constraints and decisions\\n\\n§ 7.1\\n<permissions, ownership, conventions, and user choices>\\n\\n'\n    printf '## Risks and open questions\\n\\n§ 8.1\\n<items that could affect execution>\\n\\n'\n    printf '## UI classification\\n\\n- UI affected: no\\n- Rationale: <why>\\n\\n'\n    printf '## Adversarial review\\n\\n- Artifact: `adversarial-review.md`\\n- Status: 💤 pending\\n'\n} > \"$temporary_file\"\nmv \"$temporary_file\" \"$description\"\ninventory=\"$plan_dir/work-unit-inventory.md\"\n{\n    printf '# Work-unit inventory: %s\\n\\n' \"$(basename \"$plan_dir\")\"\n    printf '## Definition-of-done coverage\\n\\n'\n    printf '| Required outcome or proof | Work unit IDs | Notes |\\n|---|---|---|\\n\\n'\n    printf '## Work units\\n\\n'\n    printf '| ID | Type | File | Primary symbol or file scope | Subscope | Intended change | Depends on | Goal | Step |\\n'\n    printf '|---|---|---|---|---|---|---|---|---|\\n\\n'\n    printf '## Decomposition review\\n\\n'\n    printf '%s\\n' '- [ ] Every definition-of-done item maps to one or more work units.'\n    printf '%s\\n' '- [ ] Every known affected file and changing symbol has its own work unit.'\n    printf '%s\\n' '- [ ] Every work unit has exactly one goal and one step.'\n    printf '%s\\n' '- [ ] Each goal has 2–10 work units, or records an allowed exception.'\n    printf '%s\\n' '- [ ] Each step has exactly one work unit and no unnamed incidental edits.'\n    printf '%s\\n' '- [ ] Dependencies form an executable order with no cycle.'\n} > \"$inventory\"\ntrap - EXIT\necho \"Created $plan_dir\"\n","exit_code":0,"status":"completed"}}
