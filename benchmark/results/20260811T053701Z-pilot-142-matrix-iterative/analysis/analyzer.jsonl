name\\\"\\n    printf '## Ownership\\\\n\\\\n- Goal: `%s`\\\\n- Work unit: `%s`\\\\n- Type: `%s`\\\\n\\\\n' \\\"$goal_name\\\" \\\"$unit_id\\\" \\\"$unit_type\\\"\\n    printf '## Change target\\\\n\\\\n- File: `%s`\\\\n- Primary symbol or file scope: `%s`\\\\n- Subscope: `%s`\\\\n\\\\n' \\\"$unit_file\\\" \\\"$scope\\\" \\\"$subscope\\\"\\n    printf '## Objective\\\\n\\\\n§ 4.1\\\\n%s\\\\n\\\\n' \\\"$intended\\\"\\n    printf '## Instructions\\\\n\\\\n§ 5.1\\\\n<direct action on this one target>\\\\n\\\\n'\\n    printf '## Acceptance criteria\\\\n\\\\n§ 6.1\\\\n<observable result for this target>\\\\n\\\\n'\\n    printf '## Handoff\\\\n\\\\n§ 7.1\\\\n<what the next named work unit can rely on>\\\\n\\\\n'\\n    printf '## Atomicity check\\\\n\\\\n- [x] This step owns exactly one inventory work unit.\\\\n- [x] No other file, symbol, test target, or verification flow changes here.\\\\n- [x] Any follow-on target has a separately named work unit and step.\\\\n'\\n} > \\\"$step_tmp\\\"\\nmv \\\"$inventory_tmp\\\" \\\"$inventory\\\"\\nmv \\\"$step_tmp\\\" \\\"$step_file\\\"\\ngoal_file=\\\"$plan_dir/$goal_name/goal.md\\\"\\nif grep -Fqx -- '<add work units with add-work-unit.sh>' \\\"$goal_file\\\"; then\\n    plan_replace_paragraph \\\"$goal_file\\\" '§ 9.1' \\\"\\\\`$unit_id\\\\` — $intended\\\"\\nelse\\n    owned_tmp=\\\"${goal_file}.tmp.$$\\\"\\n    trap 'rm -f \\\"$owned_tmp\\\"' EXIT\\n    awk -v addition=\\\"\\\\`$unit_id\\\\` — $intended\\\" '\\n        /^§ 9\\\\.[0-9]+$/ { count++ }\\n        /^## Goal-size exception$/ && !inserted {\\n            if (count == 0) exit 2\\n            print \\\"§ 9.\\\" (count + 1)\\n            print addition\\n            print \\\"\\\"\\n            inserted = 1\\n        }\\n        { print }\\n        END {\\n            if (!inserted) exit 2\\n        }\\n    ' \\\"$goal_file\\\" > \\\"$owned_tmp\\\" || plan_die \\\"Goal has no numbered Owned work units section: $goal_file\\\"\\n    mv \\\"$owned_tmp\\\" \\\"$goal_file\\\"\