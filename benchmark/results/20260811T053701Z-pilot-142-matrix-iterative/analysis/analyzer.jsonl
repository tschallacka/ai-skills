 body_file=\\\"$3\\\" temporary_file\\n127-    temporary_file=\\\"${file}.tmp.$$\\\"\\n128-    trap 'rm -f \\\"$temporary_file\\\"' RETURN\\n129-    awk -v heading=\\\"$heading\\\" -v replacement=\\\"$body_file\\\" '\\n130-        BEGIN {\\n131-            while ((getline line < replacement) > 0) {\\n132-                body = body (body == \\\"\\\" ? \\\"\\\" : \\\"\\\\n\\\") line\\n133-            }\\n134-            close(replacement)\\n135-        }\\n136-        $0 == heading {\\n137-            if (found++) exit 2\\n138-            print\\n139-            print \\\"\\\"\\n140-            print body\\n141-            skipping = 1\\n142-            next\\n143-        }\\n144-        skipping && /^## / { skipping = 0; print \\\"\\\" }\\n145-        !skipping { print }\\n146-        END { if (found != 1) exit 2 }\\n147-    ' \\\"$file\\\" > \\\"$temporary_file\\\" || plan_die \\\"Section heading was not found exactly once: $heading\\\"\\n148-    mv \\\"$temporary_file\\\" \\\"$file\\\"\\n149-    trap - RETURN\\n150-}\\n151-\\n152-plan_replace_paragraph() {\\n153-    local file=\\\"$1\\\" paragraph_id=\\\"$2\\\" content=\\\"$3\\\" temporary_file\\n154-    [[ \\\"$paragraph_id\\\" =~ ^§[[:space:]][0-9]+\\\\.[0-9]+$ ]] || plan_die \\\"Paragraph ID must use the form '§ 2.1'\\\"\\n155-    [[ \\\"$content\\\" != *$'\\\\n\\\\n'* ]] || plan_die \\\"A paragraph replacement must contain exactly one paragraph; use section for multiple paragraphs\\\"\\n156-    [ -n \\\"$content\\\" ] || plan_die \\\"Paragraph content must not be empty\\\"\\n157-    temporary_file=\\\"${file}.tmp.$$\\\"\\n158-    trap 'rm -f \\\"$temporary_file\\\"' RETURN\\n159-    awk -v wanted=\\\"$paragraph_id\\\" -v replacement=\\\"$content\\\" '\\n160-        $0 == wanted {\\n161-            if (found++) exit 2\\n162-            print\\n163-            print replacement\\n164-            skipping = 1\\n165-            next\\n166-        }\\n167-        skipping && ($0 == \\\"\\\" || /^§[[:space:]][0-9]+\