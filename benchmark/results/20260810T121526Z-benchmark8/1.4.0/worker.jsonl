 -ss|--step-section <plan-directory> <goal>/<step> <section-id> -p N.N: <content> ...\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:13:  update-plan-content.sh -rp|--review-paragraph <plan-directory> <N.N> <text>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:14:  update-plan-content.sh -rs|--review-section <plan-directory> <section-id> -p N.N: <content> ...\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:15:  update-plan-content.sh -tp|--table-paragraph <plan-directory> <document-id> <N.N> <columns> <CSV>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:16:  update-plan-content.sh -ia|--insert-after <plan-directory> <document-id> <N.N> <text>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:17:  update-plan-content.sh -ib|--insert-before <plan-directory> <document-id> <N.N> <text>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:18:  update-plan-content.sh -t|--title <plan-directory> <document-id> <title>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:19:  update-plan-content.sh -f|--field <plan-directory> <document-id> <field-label> <value>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:20:  update-plan-content.sh -tr|--testing-requirement <plan-directory> <goal-name> <yes|no> <rationale>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:21:  update-plan-content.sh -rv|--review-status <plan-directory> <pending|approved>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:22:  update-plan-content.sh -dr|--decomposition-review <plan-directory> <incomplete|completed>\n/tmp/20260810T121526Z-benchmark8/1.4.0/source/planning/scripts/update-plan-content.sh:329:        plan_dir=\"$1\"; request