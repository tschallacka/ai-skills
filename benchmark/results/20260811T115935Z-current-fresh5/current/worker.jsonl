/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/plan-env.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/validate-plan.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/add-coverage.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/create-step-testing.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/add-goal.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/configure-ui-story-cache.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/create-work-unit-inventory.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/plan-content.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/plan-mutate.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/update-step.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/plan-context-wrapper.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/plan-document-lib.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/add-ui-story.sh\n/tmp/ai-skills-capsules/20260811T115935Z-current-fresh5/current/worker/planning/scripts/update-progress.sh\n","exit_code":0,"status":"completed"}}
