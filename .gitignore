.idea/
.codegraph/
.codex/

# Agent-facing configuration and docs: the whole directory is ignored except
# the committed generic contract files that this repository ships for agents.
.agents/*
!.agents/MAINTAINER.md
!.agents/MAINTAINER-STYLE-CONTRACT.md

# Benchmark runner staging area: setup-benchmark.sh writes each agent's run
# here under benchmark/results/<agent>/.staging/ and atomically moves it into
# the published run dir only after checks pass. Leftover empty shells from
# interrupted runs are transient, never published evidence.
benchmark/results/*/.staging/

# DO NOT REMOVE these .plans lines, and do not narrow `.plans/*` to `.plans/`.
# See planning/MAINTAINER.md §1.
# Plans are transient work orders, not permanent fixtures. They live under
# .plans/ (and their .env manifests are regenerated by plan-env.sh), so none
# of it is version-controlled.
#
# NOTE: use .plans/* (not .plans/) so the directory itself stays reachable;
# this lets one specific plan under audit be pinned by negation:
#   !.plans/<plan-under-audit>/
#   !.plans/<plan-under-audit>/**
.plans/*

# Benchmark evidence tagged `current` (live working tree smoke runs) is
# transient, never published evidence: never index it.
benchmark/results/*/current/

# nix build output symlinks and direnv cache. The dev environment is a
# development dependency only; see CONTRIBUTING.md.
/result
/result-*
.direnv/

# Agent worktrees live here; they are copies of the tree, not sources.
.claude/
dist/
bug-report.md
bugs-found-by-ox-alpha.md

# Rust build artifacts for the crates under src/ (CODE-STYLE 1b).
# Never tracked: they are per-platform, large, and rebuilt by CI.
src/target/
src/*/target/
/target/
chat/runtime/chat-server-rs
src/chat-server-rs/target/

# The development tree's compiled helpers, built by ./setup-dev-env.sh into one
# bin/<target triple> for every skill to share. Never committed: they are
# per-platform, large, and rebuilt from src/ in a command. A release builds its
# own; an install gets them under $XDG_CONFIG_HOME/tsch-ai-skills/bin.
/bin/

# Built chat rust binaries. installer/build-release.sh and CI still place them
# per-skill; T72 moves that to the shared directory above, and this rule goes
# with it.
chat/bin/*/

# A local `cargo build` drop of the plan-crypt helper, the same developer
# convenience as chat/runtime/chat-server-rs above. Per-target compiled
# artifacts are CI-delivered and never tracked (planning/MAINTAINER.md
# section 2.16): a local build drops its binary here, and bootstrap.sh's
# no-nix fallback builds rjq into the shared root bin path too.
planning/bin/plan-crypt
planning/bin/plan-crypt.exe
planning/bin/*/

# The compiled plan libraries are generated by planning/scripts/build-plan-libs.sh
# from planning/scripts/lib/<group>/*.sh and are never tracked (MAINTAINER.md
# section 2.16).
planning/scripts/plan-core-lib.sh
planning/scripts/plan-crypt-lib.sh
planning/scripts/plan-document-lib.sh
planning/scripts/plan-progress-lib.sh
planning/scripts/plan-table-lib.sh

# Extensionless planning binaries are generated beside their shell oracles by
# setup-dev-env.sh. The .sh files remain tracked until their Rust replacements
# have passed the complete retirement gate.
planning/scripts/*
!planning/scripts/*.sh
!planning/scripts/lib/
!planning/scripts/lib/**
planning/scripts/plan-core-lib.sh
planning/scripts/plan-crypt-lib.sh
planning/scripts/plan-document-lib.sh
planning/scripts/plan-progress-lib.sh
planning/scripts/plan-table-lib.sh

# The reviewer contract is generated from planning/SKILL.md by
# planning/scripts/generate-reviewer.sh and pinned to its hash (MAINTAINER.md
# section 2.16).
planning/REVIEWER.md

# Workstation-only: the per-project deviation notes the project-specificies
# skill records. The skill ships; what it records about this machine does not.
project-specificies/*-deviations.md


# CI builds plan-crypt here for the suite; never committed.
.ci-bin/
