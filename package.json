{
  "name": "@tschallacka/ai-skills",
  "version": "2.0.0-alpha.7",
  "description": "Reusable skills and an installer for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tschallacka/ai-skills.git"
  },
  "homepage": "https://github.com/tschallacka/ai-skills",
  "bin": {
    "ai-skills-install": "installer/bootstrap.sh"
  },
  "scripts": {
    "install-skills": "./installer/bootstrap.sh",
    "prepack": "installer/build-release.sh --prepare >/dev/null && planning/scripts/build-plan-libs.sh >/dev/null && planning/scripts/generate-reviewer.sh >/dev/null && { d=\"$(./bootstrap.sh rjq --path-only)\" || exit 69; AI_SKILLS_BIN_ROOT=\"$d\"; export AI_SKILLS_BIN_ROOT; } && tests/test-skill-files-manifest.sh >/dev/null && tests/test-register-schemas.sh >/dev/null",
    "verify-manifest": "tests/test-skill-files-manifest.sh"
  },
  "files": [
    "installer/bootstrap.sh",
    "mods/boards",
    "mods/brainstorm-board",
    "mods/bugs-board",
    "mods/chat-board",
    "mods/ci-board",
    "mods/decision-board",
    "mods/plan-board",
    "mods/register-board",
    "mods/signal-bus",
    "mods/tailpipe-board",
    "mods/todo-board",
    "mods/tui-hint-board",
    "planning",
    "project-specifics",
    "resource-limited-testing",
    "brainstorm",
    "todo",
    "rjq",
    "bug-report",
    "decisions",
    "chat",
    "interactive-shell",
    "tui-hint-plugin",
    "git-worktrees",
    "git-merge-resolving",
    "planning/bin",
    "merge-request-etiquette",
    "text-etiquette",
    "question-etiquette",
    "post-implementation-review",
    "ai-text-editor",
    "editor-gate-plugin",
    "agent-identity-plugin",
    "chat-interrupt-plugin",
    "decision-reminder-plugin",
    "www",
    "ci-failures",
    "tailpipe",
    ".agents",
    "README.md",
    "LICENSE",
    "!interactive-shell/MODE-MANIFEST.tsv",
    "!planning/tests/**",
    "!planning/scripts/lib/**",
    "!planning/scripts/build-plan-libs.sh",
    "!planning/scripts/generate-skill-docs.sh",
    "!planning/scripts/generate-skill-docs",
    "!planning/skill-source.txt",
    "!planning/ARCHITECTURE.md",
    "!planning/MAINTAINER.md",
    "!planning/PACKAGE-MAP.tsv",
    "!planning/rust-migration.tsv",
    "!planning/MODE-MANIFEST.tsv",
    "!.agents/MAINTAINER.md",
    "!.agents/MAINTAINER-STYLE-CONTRACT.md",
    "!.agents/knowledge/**",
    "!.agents/skill-loading-experiment/**",
    "!.agents/skill-loading-findings.md",
    "!**/.ci-bin",
    "!project-specifics/*-deviations.md",
    "!agent-identity-plugin/tests/**",
    "!chat-interrupt-plugin/tests/**",
    "!decision-reminder-plugin/tests/**",
    "!editor-gate-plugin/tests/**",
    "!tui-hint-plugin/tests/**"
  ],
  "engines": {
    "node": ">=14"
  }
}
