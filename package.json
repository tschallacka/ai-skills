{
  "name": "@tschallacka/ai-skills",
  "version": "2.0.0-alpha.1",
  "description": "Reusable skills and an installer for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tschallacka/ai-skills.git"
  },
  "homepage": "https://github.com/tschallacka/ai-skills",
  "bin": {
    "ai-skills-install": "installer/bootstrap.sh"
  },
  "scripts": {
    "install-skills": "./installer/bootstrap.sh",
    "prepack": "installer/build-release.sh --prepare >/dev/null && planning/scripts/build-plan-libs.sh >/dev/null && planning/scripts/generate-reviewer.sh >/dev/null && { command -v rjq >/dev/null 2>&1 || { d=\"$(./bootstrap.sh rjq --path-only)\" || exit 69; PATH=\"$d:$PATH\"; export PATH; }; } && tests/test-skill-files-manifest.sh >/dev/null && tests/test-register-schemas.sh >/dev/null",
    "verify-manifest": "tests/test-skill-files-manifest.sh"
  },
  "files": [
    "installer/bootstrap.sh",
    "planning",
    "project-specifics",
    "resource-limited-testing",
    "brainstorm",
    "todo",
    "bug-report",
    "chat",
    "interactive-shell",
    "tui-hint-plugin",
    "git-worktrees",
    "git-merge-resolving",
    "planning/bin",
    "merge-request-etiquette",
    "text-etiquette",
    "question-etiquette",
    "post-implementation-review",
    "ai-text-editor",
    "editor-gate-plugin",
    "agent-identity-plugin",
    "www",
    "ci-failures",
    ".agents",
    "README.md",
    "LICENSE",
    "!interactive-shell/TODO.json",
    "!interactive-shell/MODE-MANIFEST.tsv",
    "!planning/tests/**",
    "!planning/scripts/lib/**",
    "!planning/scripts/build-plan-libs.sh",
    "!planning/ARCHITECTURE.md",
    "!planning/MAINTAINER.md",
    "!planning/PACKAGE-MAP.tsv",
    "!planning/rust-migration.tsv",
    "!planning/MODE-MANIFEST.tsv",
    "!.agents/knowledge/**",
    "!.agents/profiles/**",
    "!.agents/skill-loading-experiment/**",
    "!.agents/skill-loading-findings.md",
    "!**/.ci-bin",
    "!project-specifics/*-deviations.md"
  ],
  "engines": {
    "node": ">=14"
  }
}
